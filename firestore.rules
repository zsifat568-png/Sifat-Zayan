rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection (Synced with Firebase Authentication & Customer Directory)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Customers Collection (Customer Directory)
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Products: Accessible to main website and admin
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders: Storefront checkout & admin management
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Settings (Store & Royal Club)
    match /settings/{settingDoc} {
      allow read, write: if true;
    }

    // Hero Banners (Main website carousel)
    match /hero_banners/{bannerId} {
      allow read, write: if true;
    }

    match /heroBanners/{bannerId} {
      allow read, write: if true;
    }

    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // Default catch-all for any other store collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
